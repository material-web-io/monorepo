{
  "name": "@material-web/react",
  "version": "0.1.1-beta.0",
  "description": "Material 3 components for React, built with Tailwind CSS and React Aria.",
  "keywords": [
    "material-design",
    "material-3",
    "m3",
    "react",
    "tailwindcss",
    "design-system",
    "components"
  ],
  "license": "MIT",
  "author": "Yunfan Yang",
  "homepage": "https://github.com/material-web-io/monorepo/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/material-web-io/monorepo.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/material-web-io/monorepo/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "style": "./dist/tailwind.css",
      "default": "./dist/index.js"
    },
    "./tailwind.css": "./dist/tailwind.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run build:js && npm run build:types && npm run build:tailwind",
    "build:js": "vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "build:tailwind": "node scripts/inline-css.mjs",
    "prepublishOnly": "npm run --prefix ../.. check && npm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@material-web/tailwind": "0.1.1-beta.0",
    "@react-aria/live-announcer": "^3.5.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-stately": "^3.51.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss-react-aria-components": "^2.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
